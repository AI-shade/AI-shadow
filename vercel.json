{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": { "maxDuration": 60, "includeFiles": "server/data/**" },
    "api/index.js": { "maxDuration": 60, "includeFiles": "server/data/**" }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
